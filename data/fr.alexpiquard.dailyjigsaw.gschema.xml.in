<?xml version="1.0" encoding="utf-8"?>
<schemalist>
  <schema path="/fr/alexpiquard/dailyjigsaw/" id="@app-id@" gettext-domain="@gettext-package@">
    <key name="window-width" type="i">
      <default>600</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>400</default>
      <summary>Window height</summary>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Window maximized state</summary>
    </key>
    <key name="grid-size" type="i">
      <default>4</default>
      <summary>Number of pieces per axis</summary>
    </key>
    <key name="helpers" type="b">
      <default>false</default>
      <summary>Show placement helpers</summary>
    </key>
  </schema>
</schemalist>
